# Copy to .env and `source .env` (or use direnv). Never commit .env.
export HEALTH_PG_URL=postgresql://postgres:postgres@localhost:5432/health
export HEALTH_APP_TOKEN=change-me-to-a-long-random-string
export HEALTH_DATA_DIR=./data
export HEALTH_MODEL=claude-opus-5-5
export ANTHROPIC_API_KEY=sk-ant-...
# Web app origin(s) allowed to call the API
export HEALTH_CORS_ORIGINS=http://localhost:8081
